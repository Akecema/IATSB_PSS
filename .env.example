# Read by docker-compose.yml, which passes DB_* to the app container (include/config.php reads them).
# Inside compose DB_HOST is the service name "db"; outside Docker use localhost, and
# host.docker.internal from a container that must reach a DB on the host.
DB_HOST=db
DB_USER=root
DB_PASSWORD=
DB_NAME=pss_prjt_iatsb_db
APP_DEBUG=false

# docker-compose.yml only: SQL dump imported on the first start of an empty db volume.
DUMP_PATH=E:/SQL/pss_prjt_iatsb_db.sql

# Read by aac651b5c6ee/api_pdio_import.php, api_pdio_serendah.php, api_pdio_trigger.php.
PDIO_API_BASE_URL=https://devdataspider.perodua.com.my
PDIO_API_CLIENT_ID=
PDIO_API_CLIENT_SECRET=
PDIO_VENDOR_ID=211156
PDIO_ORGANIZATION=PMSB
# Read by include/guard.php: true redirects http to https (also honours X-Forwarded-Proto behind Azure/proxies).
FORCE_HTTPS=false
